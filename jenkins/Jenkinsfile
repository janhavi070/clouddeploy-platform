pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['development', 'qa', 'production'],
            description: 'Select deployment environment'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh './scripts/build-image.sh'
            }
        }

        stage('Load Image into Kind') {
            steps {
                sh './scripts/load-kind.sh'
            }
        }

        stage('Deploy with Helm') {
            steps {
                sh """
		helm upgrade --install clouddeploy ./helm/clouddeploy \
  		  -f helm/clouddeploy/values-${params.ENVIRONMENT}.yaml \
  		  -n clouddeploy
		"""
            }
        }

        stage('Verify Deployment') {
            steps {
                sh 'kubectl rollout status deployment/clouddeploy-app -n clouddeploy'
                sh 'kubectl get pods -n clouddeploy'
            }
        }
    }

    post {
        success {
            echo "CloudDeploy deployed successfully to ${params.ENVIRONMENT}"
        }

        failure {
            echo "Deployment failed!"
        }
    }
}
