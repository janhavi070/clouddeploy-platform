pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh './scripts/build-image.sh'
            }
        }

        stage('Load Image into Kind') {
            steps {
                sh './scripts/load-kind.sh'
            }
        }

        stage('Deploy with Helm') {
            steps {
                sh '''
                helm upgrade --install clouddeploy ./helm/clouddeploy \
                  -f helm/clouddeploy/values-prod.yaml \
                  -n clouddeploy
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh 'kubectl rollout status deployment/clouddeploy-app -n clouddeploy'
                sh 'kubectl get pods -n clouddeploy'
            }
        }
    }

    post {
        success {
            echo 'CloudDeploy Platform deployed successfully with Helm!'
        }

        failure {
            echo 'Deployment failed!'
        }
    }
}
