pipeline {

    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['development', 'qa', 'production'],
            description: 'Select deployment environment'
        )
    }

    environment {
        IMAGE_NAME = "janhavi070/clouddeploy-platform"
    }

    stages {

        stage('Checkout') {

            steps {

                checkout scm

                script {

                    echo "===== GIT DEBUG ====="

                    sh '''
                        pwd
                        ls -la
                        git status
                        git log -1 --oneline
                    '''

                    env.GIT_COMMIT_SHORT = sh(
                        script: "git log -1 --format=%h",
                        returnStdout: true
                    ).trim()

                    echo "Git Commit: ${env.GIT_COMMIT_SHORT}"

                }

            }

        }

        stage('Build Docker Image') {

            steps {

                withEnv([
                    "BUILD_NUMBER=${env.BUILD_NUMBER}"
                ]) {

                    sh './scripts/build-image.sh'

                }

            }

        }

        stage('Push Docker Image') {

            when {
                expression {
                    params.ENVIRONMENT == "production"
                }
            }

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKERHUB_USERNAME',
                        passwordVariable: 'DOCKERHUB_PASSWORD'
                    )
                ]) {

                    withEnv([
                        "BUILD_NUMBER=${env.BUILD_NUMBER}"
                    ]) {

                        sh '''
                        echo "$DOCKERHUB_PASSWORD" | docker login \
                        -u "$DOCKERHUB_USERNAME" \
                        --password-stdin

                        ./scripts/push-image.sh
                        '''

                    }

                }

            }

        }

        stage('Load Image Into Kind') {

            steps {

                withEnv([
                    "BUILD_NUMBER=${env.BUILD_NUMBER}"
                ]) {

                    sh './scripts/load-kind.sh'

                }

            }

        }

        stage('Deploy With Helm') {

            steps {

                withEnv([
                    "BUILD_NUMBER=${env.BUILD_NUMBER}",
                    "GIT_COMMIT=${env.GIT_COMMIT_SHORT}",
                    "ENVIRONMENT=${params.ENVIRONMENT}"
                ]) {

                    sh './scripts/deploy.sh'

                }

            }

        }

        stage('Verify Deployment') {

            steps {

                sh '''
                    kubectl rollout status deployment/clouddeploy-app -n clouddeploy
                    kubectl get pods -n clouddeploy
                '''

            }

        }

        stage('Build Summary') {

            steps {

                echo "========================================"
                echo "CloudDeploy Platform"
                echo "========================================"
                echo "Environment : ${params.ENVIRONMENT}"
                echo "Build       : ${env.BUILD_NUMBER}"
                echo "Commit      : ${env.GIT_COMMIT_SHORT}"
                echo "Image       : ${IMAGE_NAME}:${env.BUILD_NUMBER}"
                echo "========================================"

            }

        }

    }

    post {

        success {
            echo "CloudDeploy Platform deployed successfully!"
        }

        failure {
            echo "Deployment failed!"
        }

        always {
            cleanWs()
        }

    }

}
